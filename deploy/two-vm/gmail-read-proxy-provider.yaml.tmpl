id: gmail-read-proxy
display_name: Gmail read-only proxy transport
description: Inter-VM bearer for agent access to the integrations VM Gmail proxy
category: data
inference_capable: false

credentials:
  - name: access_token
    description: Random inter-VM bearer retained by the agent VM
    env_vars: [GOG_ACCESS_TOKEN]
    required: true
    auth_style: bearer
    header_name: authorization

discovery:
  credentials: [access_token]

endpoints:
  - host: saw-integ-gateway.__NAMESPACE__.svc.cluster.local
    port: 18080
    protocol: rest
    enforcement: enforce
    access: read-only

binaries:
  - /usr/local/bin/gog
