		--namespace "$(NS)" \
		--vm "$(INTEG_VM_NAME)" \
		--ssh-key "$(SSH_KEY_PATH)" \
		$(if $(GCP_PROJECT_ID),--gcp-project "$(GCP_PROJECT_ID)",) \
		$(if $(GMAIL_ACCOUNT),--gmail-account "$(GMAIL_ACCOUNT)",) \
		$(if $(AUTHORIZE_LOCAL),--authorize-local,) \
		$(if $(INSTALL_GOG_IF_MISSING),--install-gog-if-missing,) \
		$(if $(CLIENT_JSON),--client-json "$(CLIENT_JSON)",) \
		$(if $(TOKEN_EXPORT),--token-export "$(TOKEN_EXPORT)",)

verify-keycloak: ## Verify Keycloak deployment (instance, realm, clients, users, OIDC)
	@$(SCRIPTS_DIR)/verify-keycloak.sh --ns $(KEYCLOAK_NS)

verify-integ: ## Verify integrations VM setup (gateway, sandboxes, proxies, logs)
	@SSH_KEY_PATH=$(SSH_KEY_PATH) NS=$(NS) \
	$(SCRIPTS_DIR)/verify-vm.sh --vm $(INTEG_VM_NAME) --role integrations --ssh-key $(SSH_KEY_PATH) --ns $(NS)

verify-agent: ## Verify agent VM setup (gateway, sandboxes, providers, dashboard, logs)
	@SSH_KEY_PATH=$(SSH_KEY_PATH) NS=$(NS) \
	$(SCRIPTS_DIR)/verify-vm.sh --vm $(AGENT_VM_NAME) --role agent --ssh-key $(SSH_KEY_PATH) --ns $(NS)

verify: ## Verify both VMs
	@$(MAKE) verify-integ
	@echo ""
	@$(MAKE) verify-agent

