##@ Two-VM Deployment
#
# Workflow (new VMs via OpenShift Virtualization):
#   1. make generate-keys              # or use existing: SSH_KEY_PATH=~/.ssh/my_key
#   2. make deploy-config API_KEY=...  # creates SSH secrets + BOM configmap + inference secret
#   3. make deploy-integ-vm            # creates integrations VM
#   4. make deploy-agent-vm            # creates agent VM
#
# Workflow (pre-existing VMs):
#   1. make deploy-config API_KEY=...  # SSH secrets + BOM configmap + inference secret still needed
#   2. make deploy-integ-vm INTEG_HOST=10.0.1.6
#   3. make deploy-agent-vm AGENT_HOST=10.0.1.5 INTEG_HOST=10.0.1.6

AGENT_VM_NAME    ?= openshell-saw
INTEG_VM_NAME    ?= openshell-saw-integ
BOM_CHART        := charts/saw-bom
GOV_POLICY_CHART := charts/governance-policy
DEPLOY_GOV_PROFILES ?= false
AGENT_HOST       ?=
INTEG_HOST       ?=
INTEG_PORT       ?= 18083
INFERENCE_MODEL  ?= deepseek-ai/deepseek-v4-flash-0731

deploy-gov-profiles: ## Deploy governance provider profiles ConfigMap
	helm upgrade --install governance-policy $(GOV_POLICY_CHART) \
		--namespace $(NS) --set enabled=$(GOVERNANCE_ENABLED)

deploy-governance: deploy-gov-profiles ## Deploy governance interceptor + profiles
	helm upgrade --install governance-interceptor charts/governance-interceptor \
		--namespace $(NS)

bearer-secret: ## Generate inter-VM bearer secret (idempotent)
	@if kubectl get secret inter-vm-bearer -n $(NS) >/dev/null 2>&1; then \
		echo "Bearer secret already exists."; \
	else \
		BEARER=$$(openssl rand -hex 32); \
		BEARER_SHA=$$(printf '%s' "$$BEARER" | sha256sum | awk '{print $$1}'); \
		kubectl create secret generic inter-vm-bearer -n $(NS) \
			--from-literal=bearer="$$BEARER" \
			--from-literal=sha256="$$BEARER_SHA"; \
		echo "Bearer secret created."; \
	fi

deploy-config: .check-ssh-key ssh-secret deploy-bom bearer-secret ## Create SSH secrets, BOM configmap, inference secret, and bearer
	@if [ -n "$(API_KEY)" ]; then \
		$(MAKE) inference-secret; \
	fi
	@if [ "$(DEPLOY_GOV_PROFILES)" = "true" ]; then \
		$(MAKE) deploy-gov-profiles; \
	fi
	@echo "Configuration deployed."

deploy-bom: ## Deploy BOM profiles (configures workspaces, providers, sandboxes)
	helm upgrade --install saw-bom $(BOM_CHART) \
		--namespace $(NS)

deploy-agent-vm: .check-governance ## Deploy Agent VM (set AGENT_HOST= for a pre-existing VM)
	-@kubectl delete job $(AGENT_VM_NAME)-setup -n $(NS) 2>/dev/null
	@if [ -n "$(AGENT_HOST)" ]; then \
		$(SCRIPTS_DIR)/configure-vm.sh --role agent \
			--host $(AGENT_HOST) \
			--ssh-key $(SSH_KEY_PATH) \
			$(if $(INTEG_HOST),--integ-host $(INTEG_HOST)) \
			--integ-port $(INTEG_PORT) \
			--model $(if $(MODEL),$(MODEL),$(INFERENCE_MODEL)); \
	else \
		OIDC_URL="$(OIDC_ISSUER)"; \
		if [ -z "$$OIDC_URL" ]; then \
			KC_NS=$(KEYCLOAK_NS); \
			KC_HOST=$$(oc get route -n $$KC_NS -l app=keycloak -o jsonpath='{.items[0].spec.host}' 2>/dev/null); \
			if [ -z "$$KC_HOST" ]; then \
				KC_NS=$$(oc get keycloak --all-namespaces -o jsonpath='{.items[0].metadata.namespace}' 2>/dev/null || true); \
				if [ -n "$$KC_NS" ]; then KC_HOST=$$(oc get route -n $$KC_NS -l app=keycloak -o jsonpath='{.items[0].spec.host}' 2>/dev/null); fi; \
			fi; \
			if [ -n "$$KC_HOST" ]; then OIDC_URL="https://$$KC_HOST/realms/openshell"; fi; \
		fi; \
		helm upgrade --install $(AGENT_VM_NAME) $(SAW_CHART) \
			--namespace $(NS) --create-namespace \
			-f overrides/openshell-saw.yaml \
			--set sshPublicKey="$$(cat $(SSH_KEY_PATH).pub)" \
			$(if $(KEYCLOAK_NS),--set dashboard.keycloakNamespace=$(KEYCLOAK_NS)) \
			--set governance.enabled=$(GOVERNANCE_ENABLED) \
			$$([ -n "$$OIDC_URL" ] && echo "--set oidc.issuerUrl=$$OIDC_URL"); \
	fi

deploy-integ-vm: .check-governance ## Deploy Integrations VM (set INTEG_HOST= for a pre-existing VM)
	-@kubectl delete job $(INTEG_VM_NAME)-setup -n $(NS) 2>/dev/null
	@if [ -n "$(INTEG_HOST)" ]; then \
		$(SCRIPTS_DIR)/configure-vm.sh --role integ \
			--host $(INTEG_HOST) \
			--ssh-key $(SSH_KEY_PATH) \
			--integ-port $(INTEG_PORT) \
			$(if $(API_KEY),--api-key $(API_KEY)); \
	else \
		OIDC_URL="$(OIDC_ISSUER)"; \
		if [ -z "$$OIDC_URL" ]; then \
			KC_NS=$(KEYCLOAK_NS); \
			KC_HOST=$$(oc get route -n $$KC_NS -l app=keycloak -o jsonpath='{.items[0].spec.host}' 2>/dev/null); \
			if [ -z "$$KC_HOST" ]; then \
				KC_NS=$$(oc get keycloak --all-namespaces -o jsonpath='{.items[0].metadata.namespace}' 2>/dev/null || true); \
				if [ -n "$$KC_NS" ]; then KC_HOST=$$(oc get route -n $$KC_NS -l app=keycloak -o jsonpath='{.items[0].spec.host}' 2>/dev/null); fi; \
			fi; \
			if [ -n "$$KC_HOST" ]; then OIDC_URL="https://$$KC_HOST/realms/openshell"; fi; \
		fi; \
		helm upgrade --install $(INTEG_VM_NAME) $(SAW_CHART) \
			--namespace $(NS) --create-namespace \
			-f overrides/openshell-saw-integ.yaml \
			--set sshPublicKey="$$(cat $(SSH_KEY_PATH).pub)" \
			--set governance.enabled=$(GOVERNANCE_ENABLED) \
			$$([ -n "$$OIDC_URL" ] && echo "--set oidc.issuerUrl=$$OIDC_URL"); \
	fi

delete-vms: ## Delete both VMs (keeps BOM profiles and secrets)
	-helm uninstall $(AGENT_VM_NAME) -n $(NS) 2>/dev/null
	-helm uninstall $(INTEG_VM_NAME) -n $(NS) 2>/dev/null
	-kubectl delete secret inter-vm-bearer -n $(NS) 2>/dev/null
	@echo "Waiting for VMs to terminate..."
	-@kubectl wait --for=delete vm/$(AGENT_VM_NAME) vm/$(INTEG_VM_NAME) -n $(NS) --timeout=120s 2>/dev/null || true
	@echo "Resources deleted."

FORGE_UI_CHART := charts/forge-ui
UI_IMAGE       ?=
RELAY_IMAGE    ?=
DEMO_USER_EMAIL ?=

deploy-forge-ui: ## Deploy Forge UI (UI_IMAGE=, RELAY_IMAGE=, DEMO_USER_EMAIL=)
	@if [ -z "$(UI_IMAGE)" ] || [ -z "$(RELAY_IMAGE)" ] || [ -z "$(DEMO_USER_EMAIL)" ]; then \
		echo "Error: UI_IMAGE, RELAY_IMAGE, and DEMO_USER_EMAIL are required."; \
		echo "  Usage: make deploy-forge-ui UI_IMAGE=... RELAY_IMAGE=... DEMO_USER_EMAIL=user@example.com"; \
		exit 1; \
	fi
	helm upgrade --install forge-ui $(FORGE_UI_CHART) \
		--namespace $(NS) \
		--set ui.image="$(UI_IMAGE)" \
		--set relay.image="$(RELAY_IMAGE)" \
		--set userEmail="$(DEMO_USER_EMAIL)" \
		--set agentVM=$(AGENT_VM_NAME) \
		--set integVM=$(INTEG_VM_NAME)

delete-forge-ui: ## Uninstall Forge UI
	-helm uninstall forge-ui -n $(NS) 2>/dev/null
	-kubectl delete pvc rh-forge-ui-relay-store -n $(NS) 2>/dev/null

e2e-test: ## Run two-VM E2E test
