		AGENT_VM=$(AGENT_VM_NAME) INTEG_VM=$(INTEG_VM_NAME) \
		$(SCRIPTS_DIR)/test-two-vm-e2e.sh

configure-gmail-refresh: ## Configure Gmail OAuth refresh on integrations VM (interactive by default; CLIENT_JSON=, TOKEN_EXPORT= optional)
